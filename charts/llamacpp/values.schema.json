{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "service",
    "llamacpp",
    "persistence"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of replicas for the llama-server deployment"
    },
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "description": "Container image repository"
        },
        "tag": {
          "type": "string",
          "description": "Image tag; defaults to chart appVersion when empty"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "description": "Image pull policy"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "List of image pull secrets"
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full release name"
    },
    "annotations": {
      "type": "object",
      "description": "Annotations for the Deployment resource",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "type": "object",
      "description": "Annotations added to each Pod",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object",
      "description": "Security context applied at the Pod level"
    },
    "securityContext": {
      "type": "object",
      "description": "Security context applied at the container level"
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ],
          "description": "Kubernetes service type"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Port exposed by the Kubernetes service"
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "host"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable ingress record generation"
        },
        "className": {
          "type": "string",
          "description": "Ingress class name"
        },
        "annotations": {
          "type": "object",
          "description": "Annotations for the Ingress resource",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string",
          "description": "Hostname for the ingress rule"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable TLS configuration for the ingress"
            },
            "host": {
              "type": "string",
              "description": "Hostname for TLS (defaults to ingress.host)"
            },
            "secretName": {
              "type": "string",
              "description": "Secret containing the TLS certificate and private key"
            }
          }
        }
      }
    },
    "llamacpp": {
      "type": "object",
      "required": [
        "nGpuLayers",
        "contextSize",
        "parallelSlots"
      ],
      "properties": {
        "hf": {
          "type": "string",
          "description": "Hugging Face model repository"
        },
        "model": {
          "type": "string",
          "description": "Model path inside the container"
        },
        "mmproj": {
          "type": "string",
          "description": "Path to a multimodal projector file"
        },
        "mmprojAuto": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Whether to use multimodal projector file (if available), useful when using hf model"
        },
        "nGpuLayers": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Number of GPU layers to offload (0 = CPU only)"
        },
        "contextSize": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Context window size"
        },
        "parallelSlots": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Number of parallel request slots"
        },
        "threads": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Number of CPU threads to use for generation"
        },
        "mainGpu": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Index of the GPU to use as main GPU"
        },
        "splitMode": {
          "type": "string",
          "enum": [
            "none",
            "layer",
            "row"
          ],
          "description": "How to split the model across GPUs"
        },
        "tensorSplit": {
          "type": "string",
          "description": "Fraction of the model to offload to each GPU (comma-separated)"
        },
        "flashAttn": {
          "type": "string",
          "enum": [
            "on",
            "off",
            "auto"
          ],
          "description": "Enable flash attention (on to enable)"
        },
        "cacheType": {
          "type": "object",
          "description": "KV cache quantization types for keys and values",
          "properties": {
            "k": {
              "type": "string",
              "description": "KV cache quantization type for keys (e.g. f16, q8_0, q4_0)"
            },
            "v": {
              "type": "string",
              "description": "KV cache quantization type for values (e.g. f16, q8_0, q4_0)"
            }
          }
        },
        "cacheRam": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Amount of KV cache to keep in CPU RAM in MiB"
        },
        "batching": {
          "type": "object",
          "description": "Batching configuration",
          "properties": {
            "batch": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Logical maximum batch size"
            },
            "ubatch": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Physical maximum batch size"
            },
            "contBatching": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Enable continuous batching (1 to enable)"
            }
          }
        },
        "speculativeDraft": {
          "type": "object",
          "description": "Speculative decoding / draft model settings",
          "properties": {
            "type": {
              "type": "string",
              "description": "Speculative decoding type (e.g. draft-mtp)"
            },
            "draftNMax": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Maximum number of draft tokens to generate"
            },
            "draftPMin": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Minimum draft acceptance probability"
            }
          }
        },
        "sampling": {
          "type": "object",
          "description": "Sampling parameters",
          "properties": {
            "temperature": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Sampling temperature"
            },
            "topP": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Top-P nucleus sampling threshold"
            },
            "topK": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Top-K sampling threshold"
            },
            "minP": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Min-P sampling threshold"
            }
          }
        },
        "reasoningPreserve": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Preserve reasoning tokens in output (1 to enable)"
        },
        "kvUnified": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Enable unified KV cache across sequences (1 to enable)"
        },
        "extraEnv": {
          "type": "object",
          "description": "Additional arbitrary env vars to inject (key: value map)",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "enabled",
        "accessMode",
        "size"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable a PersistentVolumeClaim to store model files"
        },
        "storageClass": {
          "type": "string",
          "description": "StorageClass name; leave empty to use the cluster default"
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadOnlyMany",
            "ReadWriteMany"
          ],
          "description": "PVC access mode"
        },
        "size": {
          "type": "string",
          "description": "Size of the PersistentVolumeClaim"
        },
        "labels": {
          "type": "object",
          "description": "Additional labels for the PVC",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "description": "Additional annotations for the PVC",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "Resource requests and limits for the llama-server container",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "runtimeClassName": {
      "type": "string",
      "description": "RuntimeClassName for the pod (defaults to 'nvidia' if gpu.vendor is nvidia)"
    },
    "gpu": {
      "type": "object",
      "description": "GPU resource allocation. When set, adds vendor-specific GPU limits/requests to the container.",
      "required": [
        "vendor",
        "count"
      ],
      "properties": {
        "vendor": {
          "type": "string",
          "enum": [
            "nvidia",
            "amd"
          ],
          "description": "GPU vendor: nvidia (nvidia.com/gpu) or amd (amd.com/gpu)"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of GPUs to allocate"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "description": "Node selector for pod scheduling",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "description": "Tolerations for pod scheduling",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object",
      "description": "Affinity rules for pod scheduling"
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpGet": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": [
                "string",
                "integer"
              ]
            },
            "scheme": {
              "type": "string",
              "enum": [
                "HTTP",
                "HTTPS"
              ]
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpGet": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": [
                "string",
                "integer"
              ]
            },
            "scheme": {
              "type": "string",
              "enum": [
                "HTTP",
                "HTTPS"
              ]
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpGet": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": [
                "string",
                "integer"
              ]
            },
            "scheme": {
              "type": "string",
              "enum": [
                "HTTP",
                "HTTPS"
              ]
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
